generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== Enums ====================

enum ReturnType {
  FULL        // مرتجع كامل
  PARTIAL     // مرتجع جزئي
  EXCHANGE    // استبدال
}

enum ReturnStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// ==================== Models الأساسية ====================

model User {
  id                  String                @id @default(cuid())
  code                String                @unique
  name                String
  password            String
  role                String                @default("EMPLOYEE")
  orders              Order[]
  payments            Payment[]
  returns             ReturnOrder[]
  createdAt           DateTime              @default(now())
  
  vendorTransactions  VendorTransaction[]
  employeeTransactions EmployeeTransaction[]
  purchaseInvoices    PurchaseInvoice[]
}

model Customer {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  phone     String?
  phone2    String?
  address   String?
  source    String    @default("ADMIN")
  orders    Order[]
  payments  Payment[]
}

// =======================================
// نموذج الموردين
// =======================================

model Vendor {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  phone       String?
  phone2      String?
  address     String?
  notes       String?
  source      String   @default("MANUAL")
  
  products         Product[]
  payments         Payment[]
  transactions     VendorTransaction[]
  purchaseInvoices PurchaseInvoice[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =======================================
// حركات المورد - دفتر الأستاذ
// =======================================

model VendorTransaction {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  
  type        String   // PURCHASE, PAYMENT, RETURN
  amount      Float
  description String?
  reference   String?  // رقم الفاتورة أو السند
  
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  quantity    Int?
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  createdAt   DateTime @default(now())
}

model Product {
  id               String      @id @default(cuid())
  modelNo          String
  description      String?
  vendor           String?
  color            String
  stockQty         Int         @default(0)
  currentStock     Int         @default(0)
  price            Float
  cost             Float       @default(0.0)
  discount         Float       @default(0.0)
  status           String      @default("OPEN") 

  isStockAlertRead Boolean     @default(false)

  orderItems       OrderItem[]
  syncRecords      SyncRecord[]
  returnItems      ReturnItem[] @relation("ReturnProduct")
  exchangedItems   ReturnItem[] @relation("ExchangedProduct")

  vendorId         String?
  vendorRef        Vendor?     @relation(fields: [vendorId], references: [id])
  vendorTransactions VendorTransaction[]
  purchaseInvoiceItems PurchaseInvoiceItem[]

  @@unique([modelNo, color])
}

model Safe {
  id                  String                @id @default(cuid())
  name                String
  orders              Order[]
  payments            Payment[]             @relation("SourceSafe")
  incomingTransfers   Payment[]             @relation("TargetSafe")
  returns             ReturnOrder[]
  purchaseInvoices    PurchaseInvoice[]
  createdAt           DateTime              @default(now())
  
  employeeTransactions EmployeeTransaction[]
}

// ==================== الأوردرات ====================

model Order {
  id          String      @id @default(cuid())
  orderNo     Int         @default(autoincrement())
  createdAt   DateTime    @default(now())

  deposit     Float       @default(0.0)
  currency    String      @default("EGP")
  discount    Float       @default(0.0) 

  totalAmount Float
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  safeId      String?
  safe        Safe?       @relation(fields: [safeId], references: [id])
  items       OrderItem[]
  notes       String?

  originalReturns ReturnOrder[] @relation("OriginalOrderReturns")
  exchangeFromReturn ReturnOrder[] @relation("ExchangeNewOrder")
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id])
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int     
  fulfilledQty    Int     @default(0) 
  price           Float
  discountPercent Int     @default(0)
  isPostponed     Boolean @default(false)

  logs            FulfillmentLog[]
  returnItems     ReturnItem[]
}

model FulfillmentLog {
  id          String   @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int       
  batchId     String    
  createdAt   DateTime  @default(now())
}

// ==================== المدفوعات ====================

model Payment {
  id           String   @id @default(cuid())
  receiptNo    Int      @default(autoincrement())
  createdAt    DateTime @default(now())
  amount       Float
  currency     String   @default("EGP") 

  type         String   @default("IN")
  description  String?  

  customerId   String?  
  customer     Customer? @relation(fields: [customerId], references: [id])

  userId       String
  user         User     @relation(fields: [userId], references: [id])

  safeId       String?   
  safe         Safe?    @relation("SourceSafe", fields: [safeId], references: [id])

  targetSafeId String?  
  targetSafe   Safe?    @relation("TargetSafe", fields: [targetSafeId], references: [id])
  
  vendorId     String?
  vendor       Vendor?  @relation(fields: [vendorId], references: [id])
}

// ==================== نظام المرتجعات ====================

model ReturnOrder {
  id                String        @id @default(cuid())
  returnNo          Int           @default(autoincrement())
  originalOrderId   String
  originalOrder     Order         @relation("OriginalOrderReturns", fields: [originalOrderId], references: [id])
  
  type              ReturnType
  reason            String?
  date              DateTime      @default(now())
  
  items             ReturnItem[]
  
  totalRefund       Float         @default(0)
  depositRefunded   Float         @default(0)
  exchangeAmount    Float         @default(0)
  
  refundMethod      String        @default("CASH")
  safeId            String?
  safe              Safe?         @relation(fields: [safeId], references: [id])
  
  newOrderId        String?
  newOrder          Order?        @relation("ExchangeNewOrder", fields: [newOrderId], references: [id])
  
  status            ReturnStatus  @default(COMPLETED)
  
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  
  notes             String?
  createdAt         DateTime      @default(now())
}

model ReturnItem {
  id                  String        @id @default(cuid())
  returnOrderId       String
  returnOrder         ReturnOrder   @relation(fields: [returnOrderId], references: [id], onDelete: Cascade)
  
  orderItemId         String
  orderItem           OrderItem     @relation(fields: [orderItemId], references: [id])
  productId           String
  product             Product       @relation("ReturnProduct", fields: [productId], references: [id])
  quantity            Int
  unitPrice           Float
  refundAmount        Float
  
  exchangedProductId  String?
  exchangedProduct    Product?      @relation("ExchangedProduct", fields: [exchangedProductId], references: [id])
  exchangedQty        Int           @default(0)
  exchangedPrice      Float         @default(0)
}

// ==================== المخزن ====================

model WarehouseReceipt {
  uniqueid String   @id             
  date     DateTime                 
  empName  String                   
  modelNo  String                   
  most     Int                      

  warehouseSyncRecord WarehouseSyncRecord?

  @@index([modelNo])                
  @@index([date])                   
}

model Settings {
  id           String  @id @default(cuid())
  siteName     String?
  invoiceNotes String?
  header       String?
  footer       String?
}

model Job {
  id           String    @id @default(cuid())
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?
  type         String
  status       String    @default("PENDING")
  progress     Int       @default(0)
  logs         String?
  payload      Json?
  result       Json?

  @@index([type, status])
}

// ==================== Product Sync ====================

model SyncOperation {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  startDate   DateTime
  itemsCount  Int          @default(0)
  status      String       @default("COMPLETED")
  records     SyncRecord[]
}

model SyncRecord {
  id               String        @id @default(cuid())
  syncOperationId  String
  operation        SyncOperation @relation(fields: [syncOperationId], references: [id], onDelete: Cascade)
  
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  
  quantityAdded    Int
  uniqueKey        String        @unique

  @@index([syncOperationId])
}

// ==================== Warehouse Sync ====================

model WarehouseSyncOperation {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  startDate   DateTime
  itemsCount  Int          @default(0)
  records     WarehouseSyncRecord[]
}

model WarehouseSyncRecord {
  id                String                 @id @default(cuid())
  syncOperationId   String
  operation         WarehouseSyncOperation @relation(fields: [syncOperationId], references: [id], onDelete: Cascade)
  
  warehouseReceiptId String                @unique
  receipt           WarehouseReceipt       @relation(fields: [warehouseReceiptId], references: [uniqueid])

  @@index([syncOperationId])
}

// ==================== الموظفين والرواتب ====================

model Employee {
  id            String   @id @default(cuid())
  name          String   @unique
  phone         String?
  defaultSalary Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions EmployeeTransaction[]
}

model EmployeeTransaction {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  amount      Float
  description String

  safeId      String?
  safe        Safe?     @relation(fields: [safeId], references: [id])

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())
}

// ==================== نظام فواتير المشتريات المخصص (جديد) ====================

model PurchaseInvoice {
  id            String                @id @default(cuid())
  invoiceNo     String                @unique
  invoiceType   String                @default("PURCHASE") // PURCHASE, RETURN
  paymentStatus String                @default("CREDIT")   // CREDIT, CASH
  date          DateTime              @default(now())
  totalAmount   Float                 @default(0)
  notes         String?
  
  vendorId      String
  vendor        Vendor                @relation(fields: [vendorId], references: [id])

  safeId        String?
  safe          Safe?                 @relation(fields: [safeId], references: [id])

  userId        String
  user          User                  @relation(fields: [userId], references: [id])

  items         PurchaseInvoiceItem[]

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([invoiceNo])
  @@index([vendorId])
  @@index([date])
}

model PurchaseInvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  invoice     PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId   String
  product     Product         @relation(fields: [productId], references: [id])

  quantity    Int
  cost        Float
  price       Float           @default(0)
  description String?

  createdAt   DateTime        @default(now())

  @@index([invoiceId])
  @@index([productId])
}